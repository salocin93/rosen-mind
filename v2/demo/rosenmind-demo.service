# RosenMind public chat demo (v2/demo/app.py), served on 127.0.0.1:8000 and published by Tailscale Funnel.
# Install:  sudo cp v2/demo/rosenmind-demo.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now rosenmind-demo
# Logs:     journalctl -u rosenmind-demo -f
# Serves v2 (dpo_v2). To switch models, change ROSENMIND_WEIGHTS/ROSENMIND_ARCH below (v1: out/full_sft_768.pth + v1), then: sudo systemctl daemon-reload && sudo systemctl restart rosenmind-demo
[Unit]
Description=RosenMind chat demo
After=network-online.target
Wants=network-online.target

[Service]
User=nrosen
WorkingDirectory=/home/nrosen/RosenMind
Environment=ROSENMIND_WEIGHTS=/home/nrosen/RosenMind/v2/out/dpo_v2.pth
Environment=ROSENMIND_ARCH=v2
Environment=ROSENMIND_DEVICE=cpu
Environment=ROSENMIND_THREADS=2
# reply length: up to ROSENMIND_MAX_NEW tokens, prompt + reply within ROSENMIND_CONTEXT (v1 was fine-tuned on <=768, v2 on 1024)
Environment=ROSENMIND_MAX_NEW=700
Environment=ROSENMIND_CONTEXT=1024
Environment=PORT=8000
Environment=GRADIO_ANALYTICS_ENABLED=False
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/nrosen/RosenMind/.venv/bin/python v2/demo/app.py
Restart=on-failure
RestartSec=5
# stay out of the way of training: low CPU priority, bounded memory
Nice=10
MemoryMax=3G

[Install]
WantedBy=multi-user.target
